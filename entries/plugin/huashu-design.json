{
  "kind": "plugin",
  "id": "huashu-design",
  "version": "1.0.1",
  "engines": {
    "platform": ">=0.1.39"
  },
  "adapters": [],
  "title": {
    "en": "Huashu Design",
    "zh-CN": "Huashu Design"
  },
  "description": {
    "en": "Create interactive prototypes and App Store graphics, generate images with a configured provider, and export PDF, editable PowerPoint or video.",
    "zh-CN": "制作交互原型与 App Store 宣传图，使用已配置的服务生成素材，并导出 PDF、可编辑 PPTX 或视频。"
  },
  "source": {
    "en": "Huashu Design v3.4.2 with DSH image service support",
    "zh-CN": "Huashu Design v3.4.2（支持 DSH 生图服务）"
  },
  "dependencies": [
    "huashu-tools",
    "playwright-cache",
    "native-seed"
  ],
  "items": [
    {
      "kind": "runtime-dependency",
      "name": "huashu-python",
      "type": "python-library",
      "architectures": [
        "amd64",
        "arm64"
      ],
      "paths": [
        "venv/bin"
      ],
      "commands": [
        "python3"
      ],
      "downloads": [
        {
          "source": "pypi",
          "packages": [
            "greenlet==3.5.6",
            "pillow==13.0.0",
            "playwright==1.59.0",
            "pyee==13.0.1",
            "typing-extensions==4.16.0"
          ]
        }
      ]
    },
    {
      "kind": "plugin",
      "packageName": "huashu-design",
      "version": "3.4.2",
      "integrity": "sha512-Wggv+wwSOz5lYHeKClzBOn4OC27VX2LcqMmezlMBbhoQ4oEax+MzpMSTtPdjCoQXCIVxolXuWNbtU9ZJiuZ8pw==",
      "archive": {
        "url": "https://github.com/dake6767/huashu-design/releases/download/dsh-image-service-3.4.2/huashu-design-3.4.2.tgz"
      },
      "runtimeDependencies": [
        "huashu-python"
      ],
      "catalogDependencies": [
        "huashu-tools",
        "playwright-cache",
        "native-seed"
      ],
      "resourceBindings": [
        {
          "dependency": "huashu-tools",
          "kind": "command-path",
          "path": "assets/bin",
          "version": "1.0.0",
          "contentHash": "eeab5aa36bedf91f50b860c15ad68bc0ea6256ef2beade4604611daeb68cd57d",
          "commands": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        {
          "dependency": "playwright-cache",
          "kind": "environment",
          "path": "assets",
          "version": "1.0.0",
          "contentHash": "4eedd3893ed5d17a0815b1aeabb4826d0478ce0a0576a9b2d8bd489a1f5b8b9c",
          "name": "PLAYWRIGHT_BROWSERS_PATH"
        },
        {
          "dependency": "native-seed",
          "kind": "native-package-cache",
          "path": "assets",
          "version": "1.0.0",
          "contentHash": "66bd8a6c73ac9c641cbc86e12ac9186fb130b6a4aaea11e1c6454de61ebd9bf2",
          "packages": [
            {
              "packageName": "playwright",
              "version": "1.59.1"
            },
            {
              "packageName": "pdf-lib",
              "version": "1.17.1"
            },
            {
              "packageName": "pptxgenjs",
              "version": "4.0.1"
            }
          ]
        }
      ],
      "access": {
        "environment": [],
        "entriesYaml": ""
      },
      "serviceSlots": [
        {
          "id": "image",
          "label": {
            "en": "OpenAI-compatible image provider",
            "zh-CN": "OpenAI 兼容生图上游"
          },
          "binding": {
            "kind": "json-settings",
            "file": "huashu-design-image.json",
            "upstream": "openai-compatible",
            "deferredUpstream": true,
            "fields": [
              {
                "path": [
                  "endpoint"
                ],
                "source": "gateway-url"
              },
              {
                "path": [
                  "model"
                ],
                "source": "model"
              },
              {
                "path": [
                  "token"
                ],
                "source": "service-token"
              }
            ]
          },
          "backends": [
            {
              "id": "openai",
              "label": {
                "en": "OpenAI-compatible image provider",
                "zh-CN": "OpenAI 兼容生图上游"
              },
              "fields": [
                {
                  "name": "model",
                  "required": true,
                  "type": "text"
                }
              ],
              "protocol": "openai-image",
              "mode": "openai",
              "upstream": {
                "model": "model"
              }
            }
          ]
        }
      ]
    }
  ]
}
